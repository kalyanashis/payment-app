# ==========================================================
# Payment App
#
# Copy this file to ".env" and replace the placeholder
# values before starting the application.
# ==========================================================

# ==================================
# Database
# MySQL is expected to run on the 
# host machine.
# ==================================
DB_HOST=host.docker.internal
DB_PORT=3306

DB_USERNAME=root
DB_PASSWORD=your_database_password

AUTH_DB_NAME=authdb
ACCOUNT_DB_NAME=accountdb
TRANSACTION_DB_NAME=transactiondb
NOTIFICATION_DB_NAME=notificationdb

# ==================================
# JWT
# ==================================
JWT_SECRET=your_jwt_secret

# ==================================
# AES
# ==================================
AES_SECRET=your_aes_secret

# ==================================
# Redis
# ==================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================================
# Kafka
# ==================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ==================================
# Internal URLs
# ==================================
AUTH_SERVICE_URL=http://auth-service:8081
ACCOUNT_SERVICE_URL=http://account-service:8082
TRANSACTION_SERVICE_URL=http://transaction-service:8083

# ==================================
# SSL
# ==================================
SSL_KEYSTORE_PASSWORD=your_keystore_password